 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
  <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="☾ WAQT" android:textColor="#DEC48E" android:textStyle="bold" android:textSize="12sp" android:singleLine="true" />
