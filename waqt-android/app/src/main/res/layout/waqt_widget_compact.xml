 <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="NÆSTE BØN" android:layout_marginTop="10dp" android:letterSpacing="0.12" android:textSize="9sp" android:textColor="#DEC48E" />
 <TextView android:id="@+id/w_next" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Åbn Waqt" android:textSize="27sp" android:singleLine="true" android:fontFamily="serif" android:textColor="#FAF2E8" />
